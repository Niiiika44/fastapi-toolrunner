# Production config template. Copy to `.env.prod` and fill in real secrets.

APP_NAME=AutoRunning
ENVIRONMENT=prod
DEBUG=False
APP_PORT=8000

API_PREFIX=/api

# --- Database ---
DB_USER=autorunning
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_NAME=autorunning
DB_HOST=postgres
DB_PORT=5432

# --- Auth / JWT ---
SECRET_KEY=CHANGE-ME-run-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
STORAGE_PATH=/data/storage

# --- RabbitMQ ---
RABBITMQ_USER=autorunning
RABBITMQ_PASSWORD=CHANGE-ME-strong-broker-password
RABBITMQ_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- Flower ---
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE-ME-strong-flower-password
FLOWER_PORT=5555

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_EVENTS_DB=1

# --- Websocket ---
WS_MAX_CONNECTIONS_PER_USER=5
