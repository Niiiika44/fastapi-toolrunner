APP_NAME=AutoRunning
DEBUG=True
ENVIRONMENT=dev
APP_PORT=8000

API_PREFIX=/api

# --- Database ---
DB_USER=postgresql
DB_PASSWORD=postgresql
DB_NAME=autorunning
DB_HOST=localhost
DB_PORT=5432

# --- Auth / JWT ---
SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10000000

# --- Storage ---
STORAGE_PATH=./storage

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Flower ---
FLOWER_USER=admin
FLOWER_PASSWORD=admin
FLOWER_PORT=5555

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_EVENTS_DB=1

# --- Websocket ---
WS_MAX_CONNECTIONS_PER_USER=5

# --- Sweeper ---
SWEEPER_ENABLED=True
SWEEPER_INTERVAL_SECONDS=300
SWEEPER_STALE_AFTER_SECONDS=900
SWEEPER_BATCH_LIMIT=100
